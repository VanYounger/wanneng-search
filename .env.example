# ===== 可选配置（一般不用改，改完重启生效） =====

# 如果有代理/VPN，填在这里，程序会自动走代理访问国外网站
# SEARCH_AGENT_PROXY=http://127.0.0.1:7890

# 模型：deepseek-flash（默认，快）或 deepseek-v4-pro（更强更慢）
# DEEPSEEK_MODEL=deepseek-flash

# 自己的 API Key（不填则读 ~/.dsh/.credentials.yaml，或环境变量）
# DEEPSEEK_API_KEY=sk-...

# 服务端口
# SEARCH_AGENT_PORT=8899

# 每次提问最多精读几个网页
# SEARCH_AGENT_MAX_PAGES=6
